# Backend-only LLM Configuration (Optional: any OpenAI-compatible API)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Pretrained AI Models (Loaded securely in Python backend)
EMBEDDING_MODEL=BAAI/bge-m3
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli

# Inference Provider Configuration (auto, local, remote, huggingface)
# On Render Free (512MB RAM), set INFERENCE_PROVIDER=remote or provide HF_API_KEY
INFERENCE_PROVIDER=auto
HF_API_KEY=
EMBEDDING_API_URL=https://router.huggingface.co/hf-inference/models/BAAI/bge-m3
NLI_API_URL=https://router.huggingface.co/hf-inference/models/MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
INFERENCE_TIMEOUT_SEC=30.0

# Retrieval & Verification Thresholds
TOP_K=5
RETRIEVAL_THRESHOLD=0.48
NLI_ENTAILMENT_THRESHOLD=0.50
NLI_CONTRADICTION_THRESHOLD=0.45

# Server & CORS Configuration
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security & Constraints
MAX_FILE_SIZE_MB=25
LOG_LEVEL=INFO

